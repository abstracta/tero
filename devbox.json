{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": {
    "python": "3.13",
    "git": "latest",
    "uv": "latest",
    "poetry": {
      "version": "latest",
      // this fails because is trying to find a pyproject.toml at the root of the project
      "disable_plugin": true
    },
    // use this since 23.7.0 builds locally and takes a long time
    "nodejs": "23.6.1",
    "pnpm": "11",
    // provide libstdc++.so.6 / libz.so.1 for pip wheels (numpy, pyodbc)
    "gcc-unwrapped": {
      "version": "latest",
      "outputs": ["lib"]
    },
    "zlib": "latest",
    "unixODBCDrivers.msodbcsql18": "latest"
  },
  "env": {
    "VENV_DIR": "$DEVBOX_PROJECT_ROOT/src/backend/.venv",
    "DEVBOX_PYPROJECT_DIR": "$DEVBOX_PROJECT_ROOT/src/backend",
    // pip wheels (numpy, pyodbc) require libstdc++ and libz at runtime, which Nix does not expose on the default loader path
    "LD_LIBRARY_PATH": "$DEVBOX_PROJECT_ROOT/.devbox/extralib:$LD_LIBRARY_PATH",
    // point the nix unixODBC (pyodbc links against it) at our generated odbcinst.ini
    "ODBCSYSINI": "$DEVBOX_PROJECT_ROOT/.devbox/odbc"
  },
  "shell": {
    "init_hook": [
      "mkdir -p \"$DEVBOX_PROJECT_ROOT/.devbox/extralib\"",
      "ln -sf \"$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib/libstdc++.so.6\" \"$DEVBOX_PROJECT_ROOT/.devbox/extralib/libstdc++.so.6\"",
      "ln -sf \"$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib/libz.so.1\" \"$DEVBOX_PROJECT_ROOT/.devbox/extralib/libz.so.1\"",
      // pyodbc resolves drivers by name from odbcinst.ini; the Nix-installed driver is not in the system ODBC registry, so we generate one pointing at it
      "mkdir -p \"$DEVBOX_PROJECT_ROOT/.devbox/odbc\"",
      "_msodbc=$(ls \"$DEVBOX_PROJECT_ROOT\"/.devbox/nix/profile/default/lib/libmsodbcsql-*.so* 2>/dev/null | head -1); printf '[ODBC Driver 18 for SQL Server]\\nDescription=Microsoft ODBC Driver 18 for SQL Server\\nDriver=%s\\n' \"$_msodbc\" > \"$DEVBOX_PROJECT_ROOT/.devbox/odbc/odbcinst.ini\""
    ],
    "scripts": {
      "install": [
        "cd src",
        "pnpm install",
        "cd backend",
        "poetry install",
        "cd ../..",
        "[ -e '.env' ] || (cp src/sample.env .env && echo '.env file has been created, PLEASE CHECK THAT ALL PROPERTIES ARE PROPERLY SET!')"
      ],
      "postgres": [
        "docker compose up --build postgres migrations"
      ],
      "keycloak": [
        "docker compose up keycloak"
      ],
      "new-migration": [
        "[[ -n $1 ]] || (echo 'Missing revision message!' && exit 1)",
        "cd src/backend",
        "poetry run alembic revision --autogenerate -m \"$1\""
      ],
      "migrations": [
        "cd src/backend",
        "poetry run alembic upgrade head"
      ],
      "generate-secret-key": [
        "cd src/backend",
        "poetry run python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""
      ],
      "backend": [
        "cd src/backend",
        "poetry run python -m tero 0"
      ],
      "frontend": [
        "cd src/frontend",
        "pnpm dev"
      ],
      "secrets-cleanup": [
        "cd src/backend",
        "poetry run python -m tero.secrets_cleanup"
      ],
      "vllm": [
        "./scripts/vllm.sh"
      ],
      "playwright": [
        "docker compose up playwright"
      ],
      "browser": [
        "pnpm --dir src/browser-extension install",
        "pnpm --dir src/browser-extension run dev --port 6173"
      ],
      "build-cli": [
        "cd src/cli",
        "sh scripts/build.sh ${1:-dev}"
      ],
      "browser-build": [
        "cd src/browser-extension",
        "pnpm build",
        "cd dist",
        "[ ! -e browser-copilot.zip ] || rm browser-copilot.zip",
        "zip -r browser-copilot.zip *"
      ],
      "check": [
        "cd src/backend",
        "poetry run pyright"
      ],
      "tests": [
        "cd src/backend",
        "poetry run pytest -vv $1"
      ],
      "docker-app": [
        "docker compose up --build app"
      ],
      "docs": [
        "cd docs",
        "pnpm dev"
      ]
    }
  }
}
