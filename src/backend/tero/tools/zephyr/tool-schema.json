{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "product": {
            "type": "string",
            "enum": ["cloud", "essential"],
            "default": "cloud",
            "description": "Zephyr product"
        },
        "accessToken": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "Zephyr API access token"
        }
    },
    "required": ["product", "accessToken"],
    "additionalProperties": false
}
